# Workspace-only caches and generated validation artifacts
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/.mypy_cache/
**/.venv/
**/node_modules/
**/dist/
**/coverage/
**/*.log

# ESP-IDF and other generated build trees
**/build/
**/build-*/
**/sdkconfig
**/sdkconfig.old

# Rendered report QA output
DOCS/.report_qa_*/

# Operational model artifacts and local validation data
WIFIGUARD-BACKEND/_reference/Window3BestModelInference/dataset/**/*.npz
WIFIGUARD-BACKEND/_reference/Window3BestModelInference/dataset/*.csv
WIFIGUARD-BACKEND/_reference/Window3BestModelInference/outputs/*.csv
**/*.pt
**/*.pth
**/.validation-demo/

# Local configuration and credentials
**/.env
**/.env.*
!**/.env.example
**/certs/*.pem
**/certs/*.key

# Runtime snapshots, FCM credentials and build output are never source code.
**/.output/
**/.venv-onnx/
**/local-output/
**/artifacts/runtime-resources/*
!**/artifacts/runtime-resources/.gitkeep
**/*service-account*.json
**/google-services.json
**/*.jks
**/*.keystore
